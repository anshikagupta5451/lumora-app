# Copy to .env. Restart Expo with `npx expo start -c` after changing it.

# The backend's address as your phone sees it: your PC's Wi-Fi IPv4 (run `ipconfig`) and port 4000
EXPO_PUBLIC_API_URL=http://192.168.1.10:4000

# Google OAuth web client ID; must equal the backend's GOOGLE_WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
